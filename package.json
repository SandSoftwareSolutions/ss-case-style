{
  "name": "@sandsoftwaresolutions/case-style",
  "version": "0.1.1",
  "description": "camelCase, snake_case, kebab-case and more, with acronyms, digits and accents handled; safe key conversion for API payloads.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "case",
    "camelcase",
    "snakecase",
    "kebab-case",
    "convert"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-case-style.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-case-style/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-case-style#readme",
  "publishConfig": {
    "access": "public"
  }
}
